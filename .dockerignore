# Keep the build context small and keep secrets out of the image.
# Secrets and local state
.env
.env.*
!.env.example
.dvc/config.local
*.db

# Version control, DVC (its cache holds a full copy of the dataset, ~740 MB), editors, caches
.git
.dvc
.dvcignore
.github
.gitignore
.vscode
.idea
.pytest_cache
.ruff_cache
__pycache__
*.pyc

# Environments and large or irrelevant folders
.venv
data
runs
mlruns
mlartifacts
reports
evidence
labs
tests
scripts
samples
postman
model_api
models

# Docs
*.md

# private keys
*.pem
