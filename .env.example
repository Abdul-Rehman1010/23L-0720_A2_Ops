# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- DagsHub / MLflow ---
DAGSHUB_USER=your_dagshub_username
MLFLOW_TRACKING_URI=https://dagshub.com/your_dagshub_username/23L-0720_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token

# --- Database (used by docker compose; the host name in DATABASE_URL must be "db", the service name) ---
# Pick your own password: letters, digits, "_" and "-" only (it is placed inside a URL), and use the SAME
# value in POSTGRES_PASSWORD and in DATABASE_URL. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Local runs without Docker can override with:  $env:DATABASE_URL="sqlite:///history.db"
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=visionguard
DATABASE_URL=postgresql+psycopg://visionguard:change_me@db:5432/visionguard

# --- Serving ---
MODEL_PATH=models/champion.keras
# Leave THRESHOLD empty to use the validation-chosen threshold stored next to the model (models/champion.json).
# Set a number only to override it on purpose.
THRESHOLD=
MAX_UPLOAD_MB=5
# Time zone used to DISPLAY times (History page, show_history.py). The database always stores UTC.
DISPLAY_TZ=Asia/Karachi
FLASK_DEBUG=0
# local  = the web app runs the model itself (needs models/champion.keras)
# remote = the web app calls the cloud model API (Task 7/8); then MODEL_API_URL and MODEL_API_KEY are required, and
#          the cloud API decides the label and the threshold (THRESHOLD and MODEL_PATH are not used)
INFERENCE_MODE=local
MODEL_API_URL=
MODEL_API_KEY=
# Seconds to wait for the model API's answer in remote mode (one retry follows a timeout or a 502/503/504)
MODEL_API_TIMEOUT=10
