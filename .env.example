# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- DagsHub / MLflow ---
DAGSHUB_USER=your_dagshub_username
MLFLOW_TRACKING_URI=https://dagshub.com/your_dagshub_username/23L-0720_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token

# --- Database (Compose uses host "db"; local dev can use sqlite:///history.db) ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=visionguard
DATABASE_URL=postgresql+psycopg://visionguard:change_me@db:5432/visionguard

# --- Serving ---
MODEL_PATH=models/champion.keras
# Leave THRESHOLD empty to use the validation-chosen threshold stored next to the model (models/champion.json).
# Set a number only to override it on purpose.
THRESHOLD=
MAX_UPLOAD_MB=5
FLASK_DEBUG=0
INFERENCE_MODE=local
MODEL_API_URL=
MODEL_API_KEY=
