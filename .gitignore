# environments and secrets (also backups such as .env.bak; only the example file is committed)
.venv/
.env
.env.*
!.env.example
.dvc/config.local
# data (tracked by DVC)
/data/raw
/data/clean
/data/_download
# models fetched from the registry
/models/*
!/models/.gitkeep
# tracking / caches
mlruns/
mlartifacts/
*.db
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc

# local MLflow lab artifacts
labs/mlflow_local/artifacts/
/runs/
labs/tuner_runs/

# generated by scripts/make_bad_samples.py (larger than 5 MB)
samples/bad/too_big.jpg
# local app database
history.db
